---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Arrow from '../components/Arrow.astro';
import Sketch from '../components/Sketch.astro';
import Doodle from '../components/Doodle.astro';
import { profile, facts, photos, highlight } from '../data/load';
const links = [
  { href: '/research/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
  { href: '/about/', label: 'About me' },
  { href: '/cv/Ekaterine_Dadiani_CV.pdf', label: 'CV (PDF)' },
];
---
<Base>
  <section class="hero">
    <div class="wrap text">
      <p class="greeting">{profile.greeting}</p>
      <h1 set:html={highlight(profile.intro)} />
      <nav class="links" aria-label="Sections">
        {links.map((l) => <a href={l.href}>{l.label} <Arrow /></a>)}
      </nav>
    </div>
    <Sketch />
  </section>

  <section class="facts wrap">
    <dl class="sheet">
      {facts.map((f) => (
        <div class="frow">
          <dt><span class="ico">{(Array.isArray(f.icon) ? f.icon : [f.icon]).map((n) => <Icon name={n} size={16} />)}</span><span>{f.label}</span></dt>
          <dd>{f.text}{f.link && <>{' '}<a href={f.link} target="_blank" rel="noopener">{f.link_label ?? f.link}</a></>}</dd>
        </div>
      ))}
    </dl>
    <div class="doodle-slot"><Doodle /></div>
  </section>

  {photos.length > 0 && (
    <section class="film wrap">
      <div class="mono head"><b>On film</b></div>
      <div class="strip">
        {photos.map((p) => (
          <figure>
            <img src={p.src} alt={p.alt ?? p.caption ?? ''} loading="lazy" />
            {p.caption && <figcaption class="mono">{p.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero { position: relative; }
  .text { position: relative; z-index: 1; padding-top: 56px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .text > * { width: fit-content; }
  .greeting { font-size: 15px; color: var(--muted); }
  h1 { font-weight: 400; font-size: clamp(22px, 2.1vw, 28px); line-height: 1.38; letter-spacing: -.02em; text-wrap: pretty; max-width: 640px; color: var(--text); }
  h1 :global(.hl) { font-weight: 500; color: var(--ink); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 26px; margin-top: 4px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); font-size: 15px; font-weight: 500; border-bottom: 1px solid var(--ink); padding-bottom: 1px; }
  .links a:hover { color: var(--muted); border-color: var(--muted); text-decoration: none; }
  .hero :global(.sketch) { margin-top: -260px; }

  .facts { padding-top: 40px; padding-bottom: 24px; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 32px 64px; align-items: center; }
  .sheet { margin: 0; display: flex; flex-direction: column; max-width: 620px; }
  .frow { display: flex; align-items: baseline; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--rule); font-size: 15px; }
  .frow:first-child { border-top: 1px solid var(--rule); }
  .frow dt { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); white-space: nowrap; flex: none; }
  .frow dt .ico { display: inline-flex; gap: 4px; color: var(--ink); position: relative; top: 2px; }
  .frow::after { content: ''; flex: 1 1 auto; order: 1; border-bottom: 1px dotted #c8c8c8; position: relative; top: -4px; min-width: 24px; }
  .frow dd { margin: 0; order: 2; color: var(--ink); text-align: right; flex: none; max-width: 66%; }
  .frow dd a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #c8c8c8; }
  .frow dd a:hover { text-decoration-color: var(--ink); }
  .doodle-slot { display: flex; justify-content: center; }
  .film { padding-top: 48px; display: flex; flex-direction: column; gap: 14px; }
  .strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .strip figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .strip img { width: 100%; height: auto; border: 1px solid var(--rule); background: var(--paper); padding: 8px; }

  @media (max-width: 1200px) { .hero :global(.sketch) { margin-top: -140px; } }
  @media (max-width: 900px) {
    .text { padding-top: 36px; gap: 16px; }
    h1 { font-size: 21px; }
    .hero :global(.sketch) { margin-top: -20px; }
    .facts { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 24px; }
    .frow { font-size: 14px; }
    .frow dd { max-width: 55%; }
    .doodle-slot { justify-content: flex-start; }
  }
</style>
