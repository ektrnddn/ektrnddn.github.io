---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/PubItem.astro';
import Arrow from '../../components/Arrow.astro';
import { publications } from '../../data/load';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const papers = d.publications.map((id) => publications.find((p) => p.id === id)).filter(Boolean);
const all = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = all[idx - 1];
const next = all[idx + 1];
---
<Base title={d.title} description={d.summary} image={d.figure}>
  <article class="wrap">
    <header class="head grid12">
      <div class="meta">
        <p class="eyebrow">{String(idx + 1).padStart(2, '0')} · {d.scale}</p>
        <p class="mono">{d.status}</p>
      </div>
      <div class="titles">
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
      </div>
    </header>

    {d.figure && (
      <figure class="fig">
        <div class="figure"><img src={d.figure} alt={d.figure_caption ?? d.title} /></div>
        {d.figure_caption && <figcaption class="caption"><b>Figure.</b> {d.figure_caption}</figcaption>}
      </figure>
    )}

    <div class="body grid12">
      <div class="prose text"><Content /></div>
      <aside class="side">
        {papers.length > 0 && (
          <div class="block">
            <div class="mono"><b>Papers</b></div>
            <ul>
              {papers.map((p) => {
                const url = p!.arxiv ? `https://arxiv.org/abs/${p!.arxiv}` : p!.doi ? `https://doi.org/${p!.doi}` : p!.url;
                return <li><a href={url} target="_blank" rel="noopener">{p!.title}</a> <span class="mono">{p!.year}</span></li>;
              })}
            </ul>
          </div>
        )}
        {d.explorer && (
          <div class="block">
            <div class="mono"><b>Interactive figure</b></div>
            <a href={d.explorer} target="_blank" rel="noopener">Open the explorer full screen <Arrow kind="ext" /></a>
          </div>
        )}
        {d.internal_results && (
          <div class="block">
            <div class="mono"><b>Results page</b></div>
            <a href={d.internal_results} target="_blank" rel="noopener">DESI members only <Arrow kind="ext" /></a>
            <p class="mono">Requires a DESI login.</p>
          </div>
        )}
      </aside>
    </div>

    {d.explorer && (
      <section class="explorer">
        <div class="explorer-head">
          <div class="mono"><b>Interactive figure</b> · redshift versus projected separation, DESI DR1 dual AGN. Wheel zooms, drag pans, double-click resets.</div>
          <a href={d.explorer} target="_blank" rel="noopener" class="link-ul">Open full screen</a>
        </div>
        <iframe src={d.explorer} title="Interactive redshift–separation figure for DESI DR1 dual AGN" loading="lazy" allow="fullscreen"></iframe>
      </section>
    )}

    {papers.length > 0 && (
      <section class="pubs">
        <div class="section-head"><h2>Papers</h2></div>
        <div class="list">{papers.map((p, i) => <PubItem pub={p!} n={i + 1} />)}</div>
      </section>
    )}

    <nav class="pager" aria-label="Other projects">
      {prev ? <a href={`/research/${prev.id}/`}><span class="mono">Previous</span><span>{prev.data.title}</span></a> : <span />}
      {next ? <a href={`/research/${next.id}/`} class="nxt"><span class="mono">Next</span><span>{next.data.title}</span></a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .head { padding-top: 72px; padding-bottom: 48px; align-items: start; }
  .meta { grid-column: span 2; display: flex; flex-direction: column; gap: 6px; }
  .titles { grid-column: span 9; display: flex; flex-direction: column; gap: 22px; }
  h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(34px, 4vw, 56px); line-height: 1.06; letter-spacing: -.02em; text-wrap: pretty; }
  .fig { margin: 0 0 56px; }
  .body { align-items: start; padding-bottom: 24px; }
  .text { grid-column: 3 / span 7; font-size: 17px; }
  .side { grid-column: 11 / span 2; display: flex; flex-direction: column; gap: 24px; font-size: 14px; }
  .block { display: flex; flex-direction: column; gap: 6px; }
  .block ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .block a { display: inline-flex; align-items: center; gap: 4px; }
  .explorer { margin-top: 40px; }
  .explorer-head { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: 12px 0; flex-wrap: wrap; }
  iframe { display: block; width: 100%; height: 920px; border: 1px solid var(--rule); background: #0d0d0d; }
  .pubs .list :global(.pub:last-child) { border-bottom: 1px solid var(--rule); }
  .pager { display: flex; justify-content: space-between; gap: 24px; padding: 56px 0 0; }
  .pager a { display: flex; flex-direction: column; gap: 4px; color: var(--ink); max-width: 46%; font-family: var(--serif); font-size: 20px; line-height: 1.2; }
  .pager a.nxt { text-align: right; align-items: flex-end; }
  .pager a:hover { color: var(--accent); text-decoration: none; }
  @media (max-width: 900px) {
    .head { padding-top: 32px; padding-bottom: 28px; }
    .meta { flex-direction: row; gap: 14px; align-items: baseline; }
    .fig { margin-bottom: 32px; }
    .text { font-size: 16px; }
    iframe { height: 640px; }
    .pager { flex-direction: column; }
    .pager a { max-width: none; }
    .pager a.nxt { text-align: left; align-items: flex-start; }
  }
</style>
