---
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/PubItem.astro';
import Arrow from '../../components/Arrow.astro';
import { projects, publications } from '../../data/load';
const earlierPubs = projects.earlier.map((id) => publications.find((p) => p.id === id)!).filter(Boolean);
// [n] in the earlier-work text becomes a link to the n-th reference below.
const earlierHtml = projects.earlier_text.replace(/\[(\d+)\]/g, '<a class="ref" href="#ref-$1">[$1]</a>');
---
<Base title="Research" description="Research by Ekaterine Dadiani on massive black hole pairs, from kiloparsecs to sub-parsec scales.">
  <header class="wrap top">
    <h1>From Kiloparsecs to Sub-Parsec Scales:<br />A Multi-Messenger, Multi-Scale Census of<br /><em>Massive Black Hole Pairs</em><br />Across Cosmic Time</h1>
  </header>

  <section class="wrap grid">
    {projects.thesis.map((p) => (
      <article class="card">
        {p.figure ? (
          <a href={p.link} target="_blank" rel="noopener" class="fig"><img src={p.figure} alt={p.figure_alt ?? p.title} loading="lazy" /></a>
        ) : (
          <div class="fig placeholder"><span class="mono">{p.status}</span></div>
        )}
        <h2>{p.title}</h2>
        {p.description && <p class="desc">{p.description}</p>}
        <div class="links">
          {p.link && <a href={p.link} target="_blank" rel="noopener" class="go">Read the full story <Arrow /></a>}
          {p.extra_link && <a href={p.extra_link.url} target="_blank" rel="noopener" class="go alt">{p.extra_link.label} <Arrow kind="ext" /></a>}
        </div>
      </article>
    ))}
  </section>

  <section class="wrap earlier">
    <div class="section-head"><h2>Earlier work</h2></div>
    <p class="prose" set:html={earlierHtml} />
    <div class="pubs">
      {earlierPubs.map((p, i) => <div id={`ref-${i + 1}`}><PubItem pub={p} n={i + 1} /></div>)}
    </div>
  </section>
</Base>

<style>
  .top { padding-top: 72px; padding-bottom: 24px; }
  h1 { font-weight: 400; font-size: clamp(26px, 3vw, 40px); line-height: 1.16; letter-spacing: -.03em; }
  h1 em { font-style: normal; font-weight: 500; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 40px; padding-top: 32px; }
  .card { display: flex; flex-direction: column; gap: 16px; }
  .fig { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; border: 1px solid var(--rule); background: var(--paper); padding: 16px; overflow: hidden; }
  .fig img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  a.fig:hover { border-color: var(--ink); }
  .placeholder { border-style: dashed; }
  h2 { font-weight: 500; font-size: clamp(20px, 1.8vw, 24px); line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; }
  .desc { font-size: 16px; line-height: 1.6; color: var(--text); text-wrap: pretty; max-width: 56ch; }
  .links { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
  .go { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-size: 15px; font-weight: 500; border-bottom: 1px solid var(--ink); padding-bottom: 1px; }
  .go:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .go.alt { color: var(--muted); border-color: var(--muted); font-weight: 400; }
  .status { color: var(--muted); }
  .earlier { padding-top: 16px; }
  .earlier .prose { max-width: 800px; padding-top: 20px; padding-bottom: 28px; font-size: 17px; }
  .earlier :global(.ref) { color: var(--accent); font-family: var(--mono); font-size: 13px; }
  .pubs :global(.pub:last-child) { border-bottom: 1px solid var(--rule); }
  @media (max-width: 900px) {
    .top { padding-top: 32px; }
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  }
</style>
