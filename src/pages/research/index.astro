---
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/PubItem.astro';
import Arrow from '../../components/Arrow.astro';
import { projects, publications } from '../../data/load';
const earlierPubs = projects.earlier.map((id) => publications.find((p) => p.id === id)!).filter(Boolean);
// [n] in the earlier-work text becomes a link to the n-th reference below.
const earlierHtml = projects.earlier_text.replace(/\[(\d+)\]/g, '<a class="ref" href="#ref-$1">[$1]</a>');
---
<Base title="Research" description="Research by Ekaterine Dadiani on massive black hole pairs, from kiloparsecs to sub-parsec scales.">
  <header class="wrap top">
    <h1>From Kiloparsecs to Sub-Parsec Scales:<br />A Multi-Messenger, Multi-Scale Census of<br /><em>Massive Black Hole Pairs</em><br />Across Cosmic Time</h1>
  </header>

  <section class="strip" data-strip>
    <div class="track" data-track>
      {[0, 1, 2].map((set) => projects.thesis.map((p) => (
        <article class="card" data-card aria-hidden={set === 1 ? undefined : 'true'}>
          {p.figure ? (
            <a href={p.link} target="_blank" rel="noopener" class="fig" tabindex={set === 1 ? undefined : -1} draggable="false"><img src={p.figure} alt={p.figure_alt ?? p.title} loading="lazy" draggable="false" /></a>
          ) : (
            <div class="fig placeholder"><span class="mono">{p.status}</span></div>
          )}
          <h2>{p.title}</h2>
          {p.description && <p class="desc">{p.description}</p>}
          <div class="links">
            {p.link && <a href={p.link} target="_blank" rel="noopener" class="go" tabindex={set === 1 ? undefined : -1} draggable="false">Read the full story <Arrow /></a>}
            {p.extra_link && <a href={p.extra_link.url} target="_blank" rel="noopener" class="go alt" tabindex={set === 1 ? undefined : -1} draggable="false">{p.extra_link.label} <Arrow kind="ext" /></a>}
          </div>
        </article>
      )))}
    </div>
  </section>

  <section class="wrap earlier">
    <div class="section-head"><h2>Earlier work</h2></div>
    <p class="prose" set:html={earlierHtml} />
    <div class="pubs">
      {earlierPubs.map((p, i) => <div id={`ref-${i + 1}`}><PubItem pub={p} n={i + 1} /></div>)}
    </div>
  </section>
</Base>

<style>
  .top { padding-top: 72px; padding-bottom: 24px; }
  h1 { font-weight: 400; font-size: clamp(26px, 3vw, 40px); line-height: 1.16; letter-spacing: -.03em; }
  h1 em { font-style: normal; font-weight: 500; }
  .strip { position: relative; overflow: hidden; padding: 32px 0 40px; margin-top: 8px; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .strip.dragging { cursor: grabbing; }
  .track { display: flex; align-items: flex-start; gap: 28px; width: max-content; will-change: transform; }
  .card { flex: 0 0 auto; width: var(--w, 300px); display: flex; flex-direction: column; gap: 14px; transition: width .14s cubic-bezier(.2,.7,.2,1); }
  .fig { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; border: 1px solid var(--rule); background: var(--paper); padding: 14px; overflow: hidden; }
  .fig img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  a.fig:hover { border-color: var(--ink); }
  .placeholder { border-style: dashed; }
  .card h2 { font-size: 17px; line-height: 1.3; }
  .card .desc { font-size: 14px; }
  h2 { font-weight: 500; font-size: clamp(20px, 1.8vw, 24px); line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; }
  .desc { font-size: 16px; line-height: 1.6; color: var(--text); text-wrap: pretty; max-width: 56ch; }
  .links { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
  .go { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-size: 15px; font-weight: 500; border-bottom: 1px solid var(--ink); padding-bottom: 1px; }
  .go:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .go.alt { color: var(--muted); border-color: var(--muted); font-weight: 400; }
  .status { color: var(--muted); }
  .earlier { padding-top: 16px; }
  .earlier .prose { max-width: 800px; padding-top: 20px; padding-bottom: 28px; font-size: 17px; }
  .earlier :global(.ref) { color: var(--accent); font-family: var(--mono); font-size: 13px; }
  .pubs :global(.pub:last-child) { border-bottom: 1px solid var(--rule); }
  @media (max-width: 900px) {
    .top { padding-top: 32px; }
    .strip { padding-top: 16px; }
    .track { gap: 18px; }
    .card { width: 240px; }
  }
</style>

<script>
  // A looping belt of cards. It drifts slowly on its own, can be dragged or scrolled
  // sideways, wraps around forever, and the card nearest the cursor swells over the others.
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  if (strip && track) {
    const cards = [...track.querySelectorAll<HTMLElement>('[data-card]')];
    const per = cards.length / 3;
    const hover = matchMedia('(hover: hover)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let setW = 0, x = 0, vx = 0, px = -1e9, py = -1e9, dragging = false, lastX = 0, lastT = 0, paused = false, moved = 0;
    const measure = () => {
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      setW = cards.slice(0, per).reduce((w, c) => w + c.offsetWidth + gap, 0);
      const pad = Math.max(64, (window.innerWidth - 1312) / 2 + 64);
      if (!x) x = setW - pad;
    };
    measure(); window.addEventListener('resize', measure);
    const wrap = () => { if (x < setW * 0.5) x += setW; else if (x >= setW * 1.5) x -= setW; };
    strip.addEventListener('pointermove', (e) => {
      px = e.clientX; py = e.clientY;
      if (dragging) { const now = performance.now(); const dx = e.clientX - lastX; x -= dx; moved += Math.abs(dx); vx = -dx / Math.max(1, now - lastT) * 16; lastX = e.clientX; lastT = now; }
    });
    strip.addEventListener('pointerenter', () => { paused = true; });
    strip.addEventListener('pointerleave', () => { px = py = -1e9; paused = false; dragging = false; strip.classList.remove('dragging'); });
    strip.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse' && e.button !== 0) return; dragging = true; moved = 0; vx = 0; lastX = e.clientX; lastT = performance.now(); strip.classList.add('dragging'); strip.setPointerCapture(e.pointerId); });
    const end = () => { dragging = false; strip.classList.remove('dragging'); };
    strip.addEventListener('pointerup', end); strip.addEventListener('pointercancel', end);
    // A drag should not also count as a click on a link.
    strip.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); } }, true);
    // Sideways wheel or trackpad scrolls the belt; vertical wheel leaves the page alone.
    strip.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) { x += e.deltaX; e.preventDefault(); } }, { passive: false });
    const base = 300, grow = 200, reach = 380;
    const tick = () => {
      if (!dragging) {
        if (!paused && !reduce) vx += (0.35 - vx) * 0.02; else vx *= 0.92;
        x += vx;
      }
      wrap();
      // Dock magnification: the card nearest the cursor widens, neighbours a little; the
      // track shifts by half the growth on the cursor's left so the hovered card stays put.
      let shift = 0;
      if (hover) {
        const inside = py > strip.getBoundingClientRect().top && py < strip.getBoundingClientRect().bottom;
        for (const c of cards) {
          const r = c.getBoundingClientRect();
          const d = Math.abs(px - (r.left + r.width / 2));
          const t = inside ? Math.max(0, 1 - d / reach) : 0;
          const e = t * t * (3 - 2 * t);
          const w = base + grow * e;
          c.style.setProperty('--w', `${w.toFixed(1)}px`);
          if (r.left + r.width / 2 < px) shift += (w - base) * 0.5;
        }
      }
      track.style.transform = `translate3d(${(-(x + shift)).toFixed(2)}px, 0, 0)`;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
