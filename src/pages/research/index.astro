---
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/PubItem.astro';
import Arrow from '../../components/Arrow.astro';
import { projects, publications } from '../../data/load';
const earlierPubs = projects.earlier.map((id) => publications.find((p) => p.id === id)!).filter(Boolean);
// [n] in the earlier-work text becomes a link to the n-th reference below.
const earlierHtml = projects.earlier_text.replace(/\[(\d+)\]/g, '<a class="ref" href="#ref-$1">[$1]</a>');
---
<Base title="Research" description="Research by Ekaterine Dadiani on massive black hole pairs, from kiloparsecs to sub-parsec scales.">
  <header class="wrap thesis">
    <h1>From Kiloparsecs to Sub-Parsec Scales:<br />A Multi-Messenger, Multi-Scale Census of<br /><em>Massive Black Hole Pairs</em><br />Across Cosmic Time</h1>
  </header>

  <section class="wrap stage">
    <div class="left">
      <div class="info" data-info>
        {projects.thesis.map((p, i) => (
          <div class="entry" data-entry={i} aria-hidden={i === 0 ? undefined : 'true'}>
            <div class="mono idx">{String(i + 1).padStart(2, '0')} / {String(projects.thesis.length).padStart(2, '0')}</div>
            <h2>{p.title}</h2>
            <div class="links">
              {p.link && <a href={p.link} target="_blank" rel="noopener" class="go">Read the full story <Arrow /></a>}
              {p.extra_link && <a href={p.extra_link.url} target="_blank" rel="noopener" class="go alt">{p.extra_link.label} <Arrow kind="ext" /></a>}
              {!p.link && p.status && <span class="mono status">{p.status}</span>}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="deck" data-deck tabindex="0" aria-label="Research projects, one at a time">
      {projects.thesis.map((p, i) => (
        <div class="card" data-card={i} data-placeholder={p.figure ? undefined : 'true'}>
          {p.figure ? <img src={p.figure} alt={p.figure_alt ?? p.title} draggable="false" loading={i < 2 ? 'eager' : 'lazy'} /> : <span class="mono">{p.status}</span>}
          <div class="tag">{p.title}</div>
          {p.figure && <button type="button" class="expand" aria-label="Open larger" data-expand tabindex="-1"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 1.5h4v4M5.5 12.5h-4v-4M12.5 1.5L8 6M1.5 12.5L6 8"/></svg></button>}
        </div>
      ))}
    </div>
  </section>

  <div class="zoom" data-zoom hidden>
    <button type="button" class="zclose" aria-label="Close" data-zclose><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 4l10 10M14 4L4 14"/></svg></button>
    <img alt="" data-zimg />
    <div class="zcap" data-zcap></div>
  </div>

  <section class="wrap earlier">
    <div class="section-head"><h2>Earlier work</h2></div>
    <p class="prose" set:html={earlierHtml} />
    <div class="pubs">
      {earlierPubs.map((p, i) => <div id={`ref-${i + 1}`}><PubItem pub={p} n={i + 1} /></div>)}
    </div>
  </section>
</Base>

<style>
  .thesis { padding-top: 56px; padding-bottom: 24px; }
  h1 { font-weight: 400; font-size: clamp(26px, 3vw, 40px); line-height: 1.16; letter-spacing: -.03em; }
  h1 em { font-style: normal; font-weight: 500; }
  .stage { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: center; padding-top: 56px; padding-bottom: 24px; min-height: 620px; }
  .left { display: flex; flex-direction: column; gap: 28px; }
  .info { position: relative; min-height: 170px; }
  .entry { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 12px; opacity: 0; transform: translateY(8px); transition: opacity .35s ease, transform .35s ease; pointer-events: none; }
  .entry.on { opacity: 1; transform: none; pointer-events: auto; }
  .idx { color: var(--muted); }
  h2 { font-weight: 500; font-size: clamp(19px, 1.8vw, 24px); line-height: 1.3; letter-spacing: -.02em; text-wrap: pretty; max-width: 30ch; }
  .links { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
  .go { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-size: 15px; font-weight: 500; border-bottom: 1px solid var(--ink); padding-bottom: 1px; }
  .go:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .go.alt { color: var(--muted); border-color: var(--muted); font-weight: 400; }
  .status { color: var(--muted); }
  .deck { position: relative; height: 560px; perspective: 1200px; cursor: grab; touch-action: pan-x; user-select: none; -webkit-user-select: none; outline: none; }
  .deck:focus-visible { outline: 1px solid var(--ink); outline-offset: 8px; }
  .deck.dragging { cursor: grabbing; }
  .card { position: absolute; left: 50%; top: 50%; width: min(100%, 520px); aspect-ratio: 4 / 3; margin-left: min(-50%, -260px); margin-top: -195px; border-radius: 18px; background: #efefef; overflow: hidden; display: flex; align-items: center; justify-content: center; will-change: transform, opacity; transition: box-shadow .3s; }
  .card img { width: 100%; height: 100%; object-fit: contain; background: var(--paper); padding: 18px; transition: opacity .3s, transform .4s cubic-bezier(.2,.7,.2,1); }
  .card.active { cursor: zoom-in; }
  .card.active:hover img { transform: scale(1.03); }
  .card[data-placeholder] { border: 1px dashed var(--rule); background: var(--paper); }
  .card .tag { position: absolute; left: 18px; bottom: 14px; font-size: 13px; color: var(--muted); background: rgba(255,255,255,.85); padding: 4px 8px; border-radius: 6px; max-width: 72%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity .3s; }
  .expand { position: absolute; right: 14px; bottom: 12px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--rule); background: rgba(255,255,255,.9); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; cursor: zoom-in; opacity: 0; transition: opacity .3s; }
  .card.active:hover .expand { opacity: 1; }
  .card.slab img, .card.slab .tag, .card.slab > span, .card.slab .expand { opacity: 0; }
  .card.active { box-shadow: 0 30px 60px -30px rgba(0,0,0,.25); }
  .zoom { position: fixed; inset: 0; z-index: 60; background: rgba(255,255,255,0); transition: background .35s ease; }
  .zoom.on { background: rgba(255,255,255,.96); }
  .zoom img { position: absolute; border-radius: 12px; background: var(--paper); box-shadow: 0 40px 80px -40px rgba(0,0,0,.35); transform-origin: top left; transition: transform .5s cubic-bezier(.2,.7,.2,1); will-change: transform; }
  .zcap { position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); font-size: 14px; color: var(--muted); max-width: 80vw; text-align: center; opacity: 0; transition: opacity .3s .25s; }
  .zoom.on .zcap { opacity: 1; }
  .zclose { position: absolute; top: 18px; right: 18px; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  @media (max-width: 900px) {
    .thesis { padding-top: 32px; padding-bottom: 28px; }
    .stage { grid-template-columns: minmax(0, 1fr); gap: 20px; padding-top: 32px; min-height: 0; }
    .deck { height: 380px; }
    .card { width: min(100%, 320px); margin-left: min(-50%, -160px); margin-top: -120px; }
    .info { min-height: 130px; }
    .expand { opacity: 1; }
  }
  .earlier { padding-top: 16px; }
  .earlier .prose { max-width: 800px; padding-top: 20px; padding-bottom: 28px; font-size: 17px; }
  .earlier :global(.ref) { color: var(--accent); font-family: var(--mono); font-size: 13px; }
  .pubs :global(.pub:last-child) { border-bottom: 1px solid var(--rule); }
  @media (max-width: 900px) {
    .top { padding-top: 32px; }
    .strip { padding-top: 16px; }
    .track { gap: 18px; }
    .card { width: 240px; }
  }
</style>

<script>
  // A vertical stack of cards: the current one sits full size, the others flatten into
  // slabs above and below. Wheel, drag, arrow keys or a click on a slab move the stack.
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) {
    const cards = [...deck.querySelectorAll<HTMLElement>('[data-card]')];
    const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
    const n = cards.length;
    let target = 0, pos = 0, dragging = false, startY = 0, startPos = 0, moved = 0, wheelAcc = 0, wheelT = 0;
    const clamp = (v: number) => Math.max(0, Math.min(n - 1, v));
    const show = (i: number) => entries.forEach((e, k) => { e.classList.toggle('on', k === i); e.setAttribute('aria-hidden', k === i ? 'false' : 'true'); });
    const layout = () => {
      const H = deck.clientHeight;
      for (let k = 0; k < n; k++) {
        const d = k - pos, a = Math.abs(d), s = Math.sign(d);
        const w = Math.max(0, 1 - a);                 // 1 at the active slot
        const y = s * (Math.min(a, 1) * H * 0.42 + Math.max(0, a - 1) * 26);
        const sy = 0.1 + 0.9 * w, sx = 1 - 0.06 * Math.min(a, 3);
        const rot = -s * Math.min(a, 1) * 18;
        cards[k].style.transform = `translate3d(0, ${y.toFixed(1)}px, ${(-a * 40).toFixed(0)}px) rotateX(${rot.toFixed(1)}deg) scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`;
        cards[k].style.opacity = a > 2.6 ? '0' : String(Math.max(0.35, 1 - a * 0.22));
        cards[k].style.zIndex = String(100 - Math.round(a * 10));
        cards[k].classList.toggle('slab', w < 0.35);
        cards[k].classList.toggle('active', a < 0.5);
      }
    };
    const tick = () => { if (!dragging) pos += (target - pos) * 0.12; if (Math.abs(target - pos) < 0.001) pos = target; layout(); requestAnimationFrame(tick); };
    show(0); layout(); requestAnimationFrame(tick);
    const go = (i: number) => { target = clamp(Math.round(i)); show(target); };
    deck.addEventListener('wheel', (e) => {
      const dy = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : 0;
      if (!dy) return;
      const atEdge = (dy > 0 && target >= n - 1) || (dy < 0 && target <= 0);
      if (atEdge) return;                            // let the page scroll past the ends
      e.preventDefault();
      wheelAcc += dy; const now = performance.now();
      if (Math.abs(wheelAcc) > 60 && now - wheelT > 350) { go(target + Math.sign(wheelAcc)); wheelAcc = 0; wheelT = now; }
      if (Math.abs(wheelAcc) > 400) wheelAcc = 0;
    }, { passive: false });
    deck.addEventListener('pointerdown', (e) => { dragging = true; startY = e.clientY; startPos = pos; moved = 0; deck.classList.add('dragging'); deck.setPointerCapture(e.pointerId); });
    deck.addEventListener('pointermove', (e) => { if (!dragging) return; const dy = e.clientY - startY; moved = Math.max(moved, Math.abs(dy)); pos = clamp(startPos - dy / (deck.clientHeight * 0.42)); });
    // Zoom: the active card's figure flies out to a large centred view and back.
    const zoom = document.querySelector<HTMLElement>('[data-zoom]')!;
    const zimg = zoom.querySelector<HTMLImageElement>('[data-zimg]')!;
    const zcap = zoom.querySelector<HTMLElement>('[data-zcap]')!;
    let zsrc: HTMLElement | null = null;
    const fit = (w: number, h: number) => { const mw = innerWidth * 0.86, mh = innerHeight * 0.8; const k = Math.min(mw / w, mh / h); return { w: w * k, h: h * k }; };
    const openZoom = (card: HTMLElement) => {
      const img = card.querySelector('img'); if (!img) return;
      zsrc = card; const first = img.getBoundingClientRect();
      const nat = fit(img.naturalWidth || 4, img.naturalHeight || 3);
      const left = (innerWidth - nat.w) / 2, top = (innerHeight - nat.h) / 2 - 12;
      zimg.src = img.src; zimg.alt = img.alt; zcap.textContent = card.querySelector('.tag')?.textContent ?? '';
      Object.assign(zimg.style, { left: `${left}px`, top: `${top}px`, width: `${nat.w}px`, height: `${nat.h}px`, transition: 'none',
        transform: `translate(${first.left - left}px, ${first.top - top}px) scale(${first.width / nat.w}, ${first.height / nat.h})` });
      zoom.hidden = false; zimg.getBoundingClientRect();
      requestAnimationFrame(() => { zimg.style.transition = ''; zimg.style.transform = 'none'; zoom.classList.add('on'); });
      document.body.style.overflow = 'hidden';
    };
    const closeZoom = () => {
      if (zoom.hidden) return;
      const img = zsrc?.querySelector('img'); zoom.classList.remove('on');
      if (img) { const r = img.getBoundingClientRect(), z = zimg.getBoundingClientRect(); const left = parseFloat(zimg.style.left), top = parseFloat(zimg.style.top); zimg.style.transform = `translate(${r.left - left}px, ${r.top - top}px) scale(${r.width / z.width}, ${r.height / z.height})`; }
      setTimeout(() => { zoom.hidden = true; document.body.style.overflow = ''; }, 500);
    };
    zoom.addEventListener('click', closeZoom);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeZoom(); });
    const end = (e: PointerEvent) => {
      if (!dragging) return; dragging = false; deck.classList.remove('dragging');
      if (moved < 6) {
        const c = (e.target as HTMLElement).closest<HTMLElement>('[data-card]');
        if (c) { const i = Number(c.dataset.card); if (i === target && c.querySelector('img')) openZoom(c); else go(i); return; }
      }
      go(pos + (pos - startPos > 0 ? 0.3 : -0.3) * Math.sign(pos - startPos));
    };
    deck.addEventListener('pointerup', end); deck.addEventListener('pointercancel', end);
    deck.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); go(target + 1); } if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); go(target - 1); } });
    window.addEventListener('resize', layout);
  }
</script>
