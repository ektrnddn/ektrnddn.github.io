---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Arrow from '../components/Arrow.astro';
import Timeline from '../components/Timeline.astro';
import { profile } from '../data/load';
import lastBuilt from '../../public/cv/last-built.txt?raw';
const pdf = '/cv/Ekaterine_Dadiani_CV.pdf';
const updated = new Date(`${lastBuilt.trim()}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const photoSmall = profile.photo?.replace(/\.jpg$/, '-900.jpg');
---
<Base title="About me" description={`About ${profile.name}: education, research and papers, and the small things along the way.`}>
  <section class="wrap grid12 top">
    <div class="intro">
      <h1>About me</h1>
      <p class="lede">{profile.bio}</p>
      {profile.bio_more && <p class="lede">{profile.bio_more}</p>}
      <div class="actions">
        <a class="btn" href={pdf}>CV <Arrow kind="down" /></a>
        <span class="mono">Updated {updated}</span>
      </div>
    </div>
    {profile.photo && (
      <figure class="portrait" data-develop>
        <img src={profile.photo} srcset={`${photoSmall} 900w, ${profile.photo} 1500w`} sizes="(max-width: 900px) 100vw, 50vw" width="1500" height="1000" alt={profile.photo_alt ?? profile.name} />
      </figure>
    )}
  </section>

  <section class="wrap">
    <div class="quick">
      <div><div class="mono"><b>Advisors</b></div><div>{profile.advisors.join(' and ')}</div></div>
      <div><div class="mono"><b>Collaborations</b></div><div>{profile.collaborations.map((c) => c.name).join(' · ')}</div></div>
      <div><div class="mono"><b>Based in</b></div><div>{profile.location}</div></div>
    </div>
  </section>

  <section class="wrap">
    <Timeline />
  </section>

  <section class="wrap">
    <SectionHead title="Technical skills" />
    <div class="rows">
      {profile.skills.map((k) => (
        <div class="row grid12 r"><div class="years">{k.area}</div><div class="what">{k.items}</div></div>
      ))}
    </div>
  </section>
</Base>

<style>
  .top { padding-top: 72px; padding-bottom: 32px; align-items: end; }
  .intro { grid-column: 1 / span 6; display: flex; flex-direction: column; gap: 18px; }
  h1 { font-weight: 400; font-size: clamp(34px, 4vw, 52px); line-height: 1.05; letter-spacing: -.035em; margin-bottom: 4px; }
  .lede { max-width: 34em; }
  .actions { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
  .portrait { grid-column: 7 / span 6; margin: 0; }
  .portrait img { display: block; width: 100%; height: auto; }
  /* The print comes up out of the paper, as in the developer tray. */
  .portrait.js img { filter: contrast(.16) brightness(1.8); transition: filter 2.8s cubic-bezier(.3, .6, .2, 1); }
  .portrait.js.in img { filter: none; }
  .quick { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; padding-top: 18px; border-top: 1px solid var(--rule); font-size: 14px; line-height: 1.5; }
  .quick .mono { margin-bottom: 4px; }
  .r { gap: 24px; }
  .r .years { grid-column: span 2; }
  .r .what { grid-column: span 10; }
  @media (max-width: 900px) {
    .top { padding-top: 24px; gap: 22px; }
    .intro, .portrait { grid-column: 1 / -1; }
    .portrait { order: -1; }
    .lede { font-size: 17px; }
    .quick { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 24px; }
    .r { gap: 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait.js img { filter: none; transition: none; }
  }
</style>

<script>
  // The portrait develops once it is on screen.
  const fig = document.querySelector<HTMLElement>('[data-develop]');
  if (fig && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    fig.classList.add('js');
    new IntersectionObserver((es, io) => es.forEach((e) => {
      if (e.isIntersecting) { setTimeout(() => fig.classList.add('in'), 250); io.disconnect(); }
    }), { threshold: 0.4 }).observe(fig);
  }
</script>
