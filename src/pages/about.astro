---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Timeline from '../components/Timeline.astro';
import PortraitMeadow from '../components/PortraitMeadow.astro';
import { profile } from '../data/load';
import lastBuilt from '../../public/cv/last-built.txt?raw';
const pdf = '/cv/Ekaterine_Dadiani_CV.pdf';
const updated = new Date(`${lastBuilt.trim()}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const photoSmall = profile.photo?.replace(/\.jpg$/, '-900.jpg');
// A skills line from the CV, split into its pieces at commas and semicolons (not inside brackets).
const pieces = (s: string) => s.split(/[;,]\s*(?![^()]*\))/).map((x) => x.trim()).filter(Boolean);
---
<Base title="About me" description={`About ${profile.name}: education, research and papers, and the small things along the way.`}>
  <section class="wrap grid12 top">
    <h1>About me</h1>
    <div class="body">
      <p class="lede">{profile.bio}</p>
      {profile.bio_more && <p class="lede more">{profile.bio_more}</p>}
      <dl class="facts">
        <dt class="label">Advisors</dt><dd>{profile.advisors.join(' and ')}</dd>
        <dt class="label">Collaborations</dt><dd>{profile.collaborations.map((c) => c.name).join(' · ')}</dd>
        <dt class="label">Based in</dt><dd>{profile.location}</dd>
      </dl>
    </div>
    <div class="actions">
      <a class="btn" href={pdf}>CV <Arrow kind="down" /></a>
      <span class="label">Updated {updated}</span>
    </div>
    {profile.photo && (
      <figure class="portrait" data-develop>
        <div class="print">
          <img src={profile.photo} srcset={`${photoSmall} 900w, ${profile.photo} 1500w`} sizes="(max-width: 900px) 100vw, 576px" width="1500" height="1000" alt={profile.photo_alt ?? profile.name} />
          <PortraitMeadow />
        </div>
        {/* hide the sage before the first paint, so it is drawn in rather than shown and then redrawn */}
        <script is:inline>(function (f) { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) f.classList.add('js'); })(document.currentScript.parentNode);</script>
      </figure>
    )}
  </section>

  <section class="wrap">
    <dl class="facts skills">
      {profile.skills.map((k) => (
        <>
          <dt class="label">{k.area}</dt>
          <dd>{pieces(k.items).map((x, i) => <>{i > 0 && <span class="dot" aria-hidden="true"> · </span>}<span class="sk">{x}</span></>)}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="wrap">
    <Timeline />
  </section>

</Base>

<style>
  .top { padding-top: 72px; padding-bottom: 32px; row-gap: 0; align-items: start; }
  h1 { grid-column: 1 / span 6; grid-row: 1; margin-bottom: 22px; font-weight: 400; font-size: var(--t-xl); line-height: 1.15; letter-spacing: -.03em; }
  .body { grid-column: 1 / span 6; grid-row: 2; display: flex; flex-direction: column; gap: 18px; }
  .lede { max-width: 34em; }
  .lede.more { font-size: var(--t-md); line-height: 1.6; }
  .actions { grid-column: 1 / span 6; grid-row: 3; display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-top: 44px; }
  /* The photo stands beside the words, the full width of its column, its bottom edge just under
     the last fact; above, it reaches up beside the title as far as it needs to (its sky is cut
     away, so its top is the tower and the rooftops). Once it is on screen, the sage it was cut
     from is drawn on past its edges. */
  .portrait { grid-column: 7 / span 6; grid-row: 1 / 3; align-self: end; margin: 0; }
  .print { position: relative; }
  .print img { display: block; width: 100%; height: auto; }
  .portrait :global(.meadow) { position: absolute; left: -10%; top: 0; width: 120%; height: auto; overflow: visible; pointer-events: none; color: var(--ink); }
  .portrait :global(.meadow *) { vector-effect: non-scaling-stroke; }
  .portrait :global(.meadow .fl) { stroke-width: 1; }
  /* Hidden at once (no transition), then drawn stroke by stroke: the transitions live on .in only. */
  .portrait.js :global(.meadow path) { stroke-dasharray: 1 2; stroke-dashoffset: 1.05; }
  .portrait.js :global(.meadow .fl) { opacity: 0; }
  .portrait.js.in :global(.meadow path) { stroke-dashoffset: 0; transition: stroke-dashoffset var(--t, .5s) cubic-bezier(.45, .05, .55, .95) calc(.35s + var(--d, 0s)); }
  .portrait.js.in :global(.meadow .fl) { opacity: 1; transition: opacity .4s ease calc(.35s + var(--d, 0s)); }
  /* Facts and skills read the same way: the label on the left, the answer to its right. */
  .facts { display: grid; grid-template-columns: 200px minmax(0, 1fr); column-gap: 24px; row-gap: 8px; margin: 26px 0 0; font-size: var(--t-sm); line-height: 1.6; }
  .facts dt { margin: 0; padding-top: 1px; color: var(--muted); }
  .facts dd { margin: 0; color: var(--ink); }
  .skills { margin-top: 64px; row-gap: 12px; }
  .skills dd { color: var(--text); }
  .skills .dot { color: var(--faint); }
  @media (max-width: 900px) {
    .top { padding-top: 24px; gap: 0; }
    .top { overflow-x: clip; }
    h1, .body, .actions, .portrait { grid-row: auto; }
    .portrait { order: -1; margin: 0 0 48px; }
    .facts { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .facts dd + dt { margin-top: 10px; }
    .skills { margin-top: 40px; }
  }
</style>

<script>
  // Once the portrait is on screen, the sage is drawn on past its edges.
  const fig = document.querySelector<HTMLElement>('[data-develop]');
  if (fig?.classList.contains('js')) {
    new IntersectionObserver((es, io) => es.forEach((e) => {
      if (e.isIntersecting) { setTimeout(() => fig.classList.add('in'), 250); io.disconnect(); }
    }), { threshold: 0.4 }).observe(fig);
  }
</script>
