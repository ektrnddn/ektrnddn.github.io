---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>Nothing at this address.</h1>
    <p class="lede">Try the <a href="/">home page</a>, <a href="/research/">research</a>, or <a href="/publications/">publications</a>, or <a href="/about/">about me</a>.</p>
  </section>
</Base>
<style>
  .nf { padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 20px; }
  h1 { font-weight: 400; font-size: clamp(34px, 4vw, 52px); letter-spacing: -.035em; }
</style>
