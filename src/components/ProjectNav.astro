---
import { getCollection } from 'astro:content';
interface Props { current: string }
const { current } = Astro.props;
const all = (await getCollection('research')).filter((e) => e.data.step).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((e) => e.id === current);
const prev = all[i - 1]; const next = all[i + 1];
---
<nav class="pnav wrap" aria-label="Thesis steps">
  <div class="steps">
    {all.map((e) => <a href={`/research/${e.id}/`} class:list={['s', { on: e.id === current }]}><span class="mono">{e.data.step}</span><span>{e.data.stage}</span></a>)}
  </div>
  <div class="pager">
    {prev ? <a href={`/research/${prev.id}/`}><span class="mono">Previous</span><span>{prev.data.title}</span></a> : <span />}
    {next ? <a href={`/research/${next.id}/`} class="nxt"><span class="mono">Next</span><span>{next.data.title}</span></a> : <span />}
  </div>
</nav>
<style>
  .pnav { padding-top: 64px; display: flex; flex-direction: column; gap: 28px; }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .s { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border: 1px solid var(--rule); color: var(--ink); font-size: 14px; }
  .s:hover { border-color: var(--ink); text-decoration: none; }
  .s.on { border-color: var(--accent); background: #fff8f7; }
  .pager { display: flex; justify-content: space-between; gap: 24px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; color: var(--ink); max-width: 46%; font-family: var(--serif); font-size: 20px; line-height: 1.2; }
  .pager a.nxt { text-align: right; align-items: flex-end; }
  .pager a:hover { color: var(--accent); text-decoration: none; }
  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } .pager { flex-direction: column; } .pager a { max-width: none; } .pager a.nxt { text-align: left; align-items: flex-start; } }
</style>
