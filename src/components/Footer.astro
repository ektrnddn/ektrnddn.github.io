---
import { profile } from '../data/load';
import PixelWord from './PixelWord.astro';
import Doodle from './Doodle.astro';
const labels: Record<string, string> = { github: 'GitHub', ads: 'ADS', scholar: 'Google Scholar', linkedin: 'LinkedIn', orcid: 'ORCID' };
// The contact row: ADS, GitHub and LinkedIn after the email.
const external = (['ads', 'github', 'linkedin'] as const).map((k) => [k, profile.links[k]] as const).filter(([, v]) => typeof v === 'string' && v.startsWith('http'));
// The block-letter name and the friend's sketch sign the home page only.
const home = Astro.url.pathname === '/';
---
<footer id="contact" class="footer">
  <div class="wrap"><div class="bottom">
    <div class="left">
      <span class="label">© {new Date().getFullYear()}</span>
      <span class="aff">{profile.affiliation}, {profile.location}</span>
    </div>
    <div class="links">
      <a href={`mailto:${profile.email}`} class="mail">{profile.email}</a>
      {external.map(([k, v]) => <a href={v} rel="me noopener" target="_blank">{labels[k] ?? k}</a>)}
    </div>
  </div></div>
  {home && (
  <div class="wrap word" data-word>
    <PixelWord lines={['EKATERINE', 'DADIANI']} />
    <!-- The sketch stands on the base of the last I, as tall as its stem; placed by the script below. -->
    <div class="tag" data-tag><Doodle /></div>
    <div class="note" data-note aria-hidden="true">
      <span class="label cap">as drawn<br />by a friend</span>
      <svg class="arrow" viewBox="0 0 60 56" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path pathLength="1" class="curve" d="M50 4 C 52 20, 40 34, 24 40 C 18 42, 12 46, 8 52" />
        <path pathLength="1" class="head" d="M4 44 l4 9 l9 -3" />
      </svg>
    </div>
  </div>
  )}
</footer>
<style>
  .footer { margin-top: 96px; }
  .bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; flex-wrap: wrap; padding-top: 12px; padding-bottom: 48px; border-top: 1px solid var(--rule); }
  .left { display: flex; gap: 20px; align-items: baseline; flex-wrap: wrap; }
  .aff { font-size: var(--t-sm); color: var(--muted); }
  .links { display: flex; gap: 20px; flex-wrap: wrap; font-size: var(--t-sm); }
  .links a { color: var(--muted); }
  .links a.mail { color: var(--ink); }
  .links a:hover { color: var(--accent); }
  .word { position: relative; padding-bottom: 0; }
  .tag { position: absolute; left: 0; top: 0; height: 0; visibility: hidden; }
  .tag.placed { visibility: visible; }
  .tag :global(.doodle) { height: 100%; }
  .tag :global(.doodle svg) { width: auto; height: 100%; max-width: none; }
  .tag :global(.doodle figcaption) { display: none; }
  .tag :global(.doodle .ground) { display: none; }
  .tag :global(.doodle .ground.cat) { display: block; }
  .note { position: absolute; left: 0; top: 0; width: 84px; color: var(--faint); visibility: hidden; }
  .note.placed { visibility: visible; }
  .note .cap { display: block; color: var(--faint); font-size: var(--t-xs); line-height: 1.35; opacity: 0; transition: opacity .5s ease 2.6s; }
  .note .arrow { width: 44px; height: auto; display: block; margin: 2px 0 0 -14px; }
  .note .arrow path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .7s cubic-bezier(.4,0,.2,1) 2.8s; }
  .note .arrow .head { transition-delay: 3.4s; transition-duration: .3s; }
  .word.up .note .cap { opacity: 1; }
  .word.up .note .arrow path { stroke-dashoffset: 0; }
  @media (max-width: 900px) { .footer { margin-top: 64px; } .bottom { padding-bottom: 32px; } .links { gap: 14px; } .links a.mail { flex-basis: 100%; } .note { display: none; } }
</style>
<script>
  // Put the sketch on the base bar of the last letter, right of its stem, as tall as the gap
  // between the letter's top and base bars; the caption sits just past the cat.
  const word = document.querySelector<HTMLElement>('[data-word]');
  if (word) {
    const svg = word.querySelector<SVGSVGElement>('svg[data-anchor]');
    const tag = word.querySelector<HTMLElement>('[data-tag]');
    const note = word.querySelector<HTMLElement>('[data-note]');
    if (svg && tag && note) {
      const a = JSON.parse(svg.dataset.anchor ?? '{}');
      const place = () => {
        const r = svg.getBoundingClientRect(), w = word.getBoundingClientRect();
        const s = r.width / svg.viewBox.baseVal.width;
        const h = (a.barTop - a.capBottom) * s;              // the stem's height
        const left = r.left - w.left + (a.stemRight + 2) * s;
        const top = r.top - w.top + a.barTop * s - h * 0.93;  // feet sit on the base bar
        Object.assign(tag.style, { left: `${left}px`, top: `${top}px`, height: `${h}px` });
        tag.classList.add('placed');
        const tw = h * 330 / 430;
        Object.assign(note.style, { left: `${left + tw + 8}px`, top: `${top + h * 0.12}px` });
        note.classList.add('placed');
      };
      place(); new ResizeObserver(place).observe(word);
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { word.classList.add('up'); io.disconnect(); } }), { threshold: 0.5 });
      io.observe(word);
    }
  }
</script>
