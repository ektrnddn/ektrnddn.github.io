---
// Small stroke icons, 20px grid.
interface Props { name: string; size?: number }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'pin' && <><path d="M10 18s6-5.2 6-9.5A6 6 0 0 0 4 8.5C4 12.8 10 18 10 18z"/><circle cx="10" cy="8.5" r="2"/></>}
  {name === 'mountain' && <><path d="M2 16l5-9 3 5 2-3 6 7H2z"/><path d="M7 7l1.5 2.5L10 8"/></>}
  {name === 'camera' && <><rect x="2.5" y="6" width="15" height="10.5" rx="1.5"/><circle cx="10" cy="11.2" r="3"/><path d="M7 6l1.2-2h3.6L13 6"/></>}
  {name === 'icecream' && <><path d="M6.5 9.5L10 18l3.5-8.5"/><path d="M5.5 8.5a4.5 4.5 0 0 1 9 0c0 .8-.3 1-1 1h-7c-.7 0-1-.2-1-1z"/><path d="M8 4.5a2.5 2.5 0 0 1 4 0"/></>}
  {name === 'mic' && <><rect x="7.5" y="2.5" width="5" height="9" rx="2.5"/><path d="M4.5 9.5a5.5 5.5 0 0 0 11 0"/><path d="M10 15v2.5M7.5 17.5h5"/></>}
  {name === 'star' && <path d="M10 2.5l2.3 4.8 5.2.7-3.8 3.6.9 5.2L10 14.3l-4.6 2.5.9-5.2L2.5 8l5.2-.7z"/>}
</svg>
