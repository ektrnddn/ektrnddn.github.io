  <figcaption class="mono">as drawn by a friend</figcaption>
</figure>
<style>
  .doodle { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--ink); }
  .doodle svg { width: 100%; max-width: 210px; height: auto; display: block; }
  .doodle figcaption { color: var(--muted); font-size: 11px; opacity: 0; transition: opacity .6s ease 2.4s; }
  .doodle path, .doodle ellipse, .doodle circle { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(.4,0,.2,1) var(--d, 0s), fill-opacity .4s ease calc(var(--d, 0s) + .9s); }
  .doodle [fill="currentColor"] { fill-opacity: 0; }
  .doodle.draw path, .doodle.draw ellipse, .doodle.draw circle { stroke-dashoffset: 0; }
  .doodle.draw [fill="currentColor"] { fill-opacity: 1; }
  .doodle.draw figcaption { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .doodle path, .doodle ellipse, .doodle circle { stroke-dashoffset: 0; transition: none; } .doodle [fill="currentColor"] { fill-opacity: 1; } .doodle figcaption { opacity: 1; } }
</style>
<script>
  // Stagger the strokes so the figure draws itself top to bottom when it scrolls into view.
  document.querySelectorAll<HTMLElement>('[data-doodle]').forEach((fig) => {
    const parts = [...fig.querySelectorAll<SVGGeometryElement>('path, ellipse, circle')];
    parts.forEach((el, i) => el.style.setProperty('--d', `${(i / parts.length) * 2}s`));
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { fig.classList.add('draw'); io.disconnect(); } }), { threshold: 0.4 });
    io.observe(fig);
  });
</script>
