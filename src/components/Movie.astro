---
// The research in one film: two galaxies merge, their black holes light up as a dual AGN, sink
// into one unresolved binary and merge in gravitational waves. Rendered from simulations by
// docs/movie. Beside it, the three stages with the projects on each; the one on screen is lit, and
// a click on a stage plays its part. The film plays while it is on screen.
import Arrow from './Arrow.astro';
import { movie, projectByTitle } from '../data/load';
const stages = movie.chapters.map((c) => ({ ...c, work: c.projects.map(projectByTitle) }));
---
<section class="movie wrap" data-movie aria-label="From two galaxies to gravitational waves">
  <a href="/research/" class="big">See the research <Arrow /></a>
  <div class="stage">
    <div class="screen">
      <video data-video muted playsinline loop preload="metadata" poster="/movie/poster.jpg"
        aria-label="Two simulated galaxies merge; their black holes light up, sink together into one point and merge.">
        <source src="/movie/merger.webm" type="video/webm" />
        <source src="/movie/merger.mp4" type="video/mp4" />
      </video>
      <button type="button" class="toggle" data-toggle aria-label="Pause">
        <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4.5 3v8M9.5 3v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4.5 2.8v8.4L11 7z" fill="currentColor" /></svg>
      </button>
    </div>
    <ol class="notes">
      {stages.map((s) => (
        <li class="note" data-note>
          <button type="button" class="head" data-seek={s.at}>
            <span class="bar"><span class="fill" /></span>
            <span class="name">{s.name} <span class="mono">{s.scale}</span></span>
          </button>
          <p>{s.text}</p>
          <ul class="work">
            {s.work.map((p) => (
              <li>
                {p.link ? <a href={p.link} target="_blank" rel="noopener">{p.title} <Arrow kind="ext" /></a> : <span>{p.title}</span>}
                {!p.link && p.status && <span class="mono">{p.status}</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .movie { padding-top: 24px; padding-bottom: 8px; display: flex; flex-direction: column; }
  .big { display: inline-flex; align-items: center; gap: 12px; font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -.03em; color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 2px; width: fit-content; }
  .big:hover { color: var(--muted); border-color: var(--muted); text-decoration: none; }
  .big :global(svg) { width: 22px; height: 22px; }
  .stage { margin-top: 24px; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .screen { position: relative; aspect-ratio: 1; background: var(--paper); }
  video { display: block; width: 100%; height: 100%; object-fit: contain; background: var(--paper); cursor: pointer; }
  .toggle { position: absolute; top: 10px; right: 10px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; opacity: .55; transition: opacity .25s, border-color .25s; }
  .toggle:hover, .toggle:focus-visible { opacity: 1; border-color: var(--ink); }
  .toggle .i-play { display: none; }
  .movie.paused .toggle .i-play { display: block; }
  .movie.paused .toggle .i-pause { display: none; }
  .notes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 36px; }
  .note { opacity: .36; transition: opacity .4s; }
  .note:hover { opacity: .7; }
  .note.on { opacity: 1; }
  .head { appearance: none; border: 0; background: none; padding: 0; margin: 0; font: inherit; color: var(--ink); text-align: left; cursor: pointer; display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .bar { display: block; height: 1px; background: var(--rule); overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left center; }
  .name { font-size: 16px; font-weight: 500; letter-spacing: -.01em; }
  .name .mono { margin-left: 6px; }
  .note p { margin-top: 8px; font-size: 14.5px; line-height: 1.6; color: var(--text); text-wrap: pretty; }
  .work { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .work li { font-size: 13.5px; line-height: 1.45; color: var(--ink); }
  .work a { color: var(--ink); text-decoration: none; }
  .work a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .work :global(svg) { display: inline; vertical-align: -1px; margin-left: 2px; }
  .work .mono { margin-left: 8px; }
  @media (max-width: 900px) {
    .stage { grid-template-columns: minmax(0, 1fr); gap: 28px; margin-top: 16px; }
    .toggle { top: 8px; right: 8px; }
    .notes { gap: 26px; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-movie]');
  const video = root?.querySelector<HTMLVideoElement>('[data-video]');
  if (root && video) {
    const heads = [...root.querySelectorAll<HTMLButtonElement>('[data-seek]')];
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')];
    const fills = heads.map((h) => h.querySelector<HTMLElement>('.fill')!);
    const starts = heads.map((h) => Number(h.dataset.seek));
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let want = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false, raf = 0, cur = -1;
    const show = () => {
      root.classList.toggle('paused', !want);
      toggle.setAttribute('aria-label', want ? 'Pause' : 'Play');
    };
    const sync = () => {
      if (seen && want) video.play().catch(() => { want = false; show(); });
      else video.pause();
      show();
    };
    const draw = () => {
      const t = video.currentTime, end = video.duration || starts[starts.length - 1] + 6;
      let i = 0;
      starts.forEach((s, k) => { if (t >= s) i = k; });
      if (i !== cur) { cur = i; notes.forEach((n, k) => n.classList.toggle('on', k === i)); }
      fills.forEach((f, k) => {
        const a = starts[k], b = k + 1 < starts.length ? starts[k + 1] : end;
        f.style.transform = `scaleX(${Math.min(1, Math.max(0, (t - a) / (b - a)))})`;
      });
    };
    const loop = () => { draw(); raf = seen ? requestAnimationFrame(loop) : 0; };
    new IntersectionObserver(([e]) => {
      seen = e.isIntersecting && e.intersectionRatio > 0.3;
      sync();
      if (seen && !raf) raf = requestAnimationFrame(loop);
    }, { threshold: 0.35 }).observe(video);
    const flip = () => { want = video.paused; sync(); };
    toggle.addEventListener('click', flip);
    video.addEventListener('click', flip);
    video.addEventListener('timeupdate', draw);
    video.addEventListener('seeked', draw);
    heads.forEach((h, k) => h.addEventListener('click', () => {
      video.currentTime = starts[k] + 0.01;
      want = true; sync(); draw();
    }));
    draw();
  }
</script>
