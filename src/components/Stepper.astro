---
// Clickable pipeline: a row of steps, one expanded at a time.
interface Step { title: string; detail: string; tag?: string }
interface Props { steps: Step[]; label?: string }
const { steps, label = 'Pipeline' } = Astro.props;
const id = `stp-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="stepper" data-stepper id={id}>
  <div class="mono head"><b>{label}</b> · click a step</div>
  <div class="track">
    {steps.map((s, i) => (
      <button class:list={['step', { active: i === 0 }]} type="button" data-i={i} aria-expanded={i === 0 ? 'true' : 'false'}>
        <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
        <span class="title">{s.title}</span>
        {s.tag && <span class="mono tag">{s.tag}</span>}
      </button>
    ))}
  </div>
  <div class="details">
    {steps.map((s, i) => <div class:list={['detail', { active: i === 0 }]} data-i={i}>{s.detail}</div>)}
  </div>
</div>
<style>
  .stepper { display: flex; flex-direction: column; gap: 14px; }
  .track { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 8px; }
  .step { appearance: none; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); text-align: left; padding: 14px 14px 12px; border-radius: 2px; cursor: pointer; display: flex; flex-direction: column; gap: 6px; font: inherit; position: relative; transition: border-color .2s, background .2s; }
  .step:hover { border-color: var(--ink); }
  .step.active { border-color: var(--accent); background: #fff8f7; }
  .step.active::after { content: ''; position: absolute; left: 50%; bottom: -9px; width: 14px; height: 14px; background: #fff8f7; border-right: 1px solid var(--accent); border-bottom: 1px solid var(--accent); transform: translateX(-50%) rotate(45deg); }
  .idx { color: var(--accent); }
  .title { font-size: 14px; font-weight: 500; line-height: 1.3; }
  .tag { color: var(--muted); font-size: 11px; }
  .details { border: 1px solid var(--accent); border-radius: 2px; background: #fff8f7; padding: 18px 20px; }
  .detail { display: none; font-size: 15px; line-height: 1.6; color: var(--text); }
  .detail.active { display: block; }
  @media (max-width: 900px) {
    .track { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .step.active::after { display: none; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((root) => {
    const steps = root.querySelectorAll<HTMLButtonElement>('.step');
    const details = root.querySelectorAll<HTMLElement>('.detail');
    steps.forEach((b) => b.addEventListener('click', () => {
      const i = b.dataset.i;
      steps.forEach((s) => { const on = s.dataset.i === i; s.classList.toggle('active', on); s.setAttribute('aria-expanded', on ? 'true' : 'false'); });
      details.forEach((d) => d.classList.toggle('active', d.dataset.i === i));
    }));
  });
</script>
