---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'research'>; }
const { entry } = Astro.props;
const d = entry.data;
const statusLabel: Record<string, string> = { published: 'Published', review: 'Under collaboration review', progress: 'In progress', planned: 'Next up' };
---
<header class="ph wrap">
  <div class="top">
    <span class="eyebrow">Step {d.step} · {d.stage}</span>
    <span class:list={['chip', d.status_kind]}>{statusLabel[d.status_kind]}</span>
  </div>
  <h1>{d.title}</h1>
  <p class="lede">{d.summary}</p>
  <dl class="meta">
    <div><dt class="mono">Scale</dt><dd>{d.scale}</dd></div>
    <div><dt class="mono">Data</dt><dd>{d.data}</dd></div>
    <div><dt class="mono">Status</dt><dd>{d.status}</dd></div>
    {d.with && <div><dt class="mono">With</dt><dd>{d.with}</dd></div>}
  </dl>
</header>
<style>
  .ph { padding-top: 64px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 22px; }
  .top { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 4.6vw, 64px); line-height: 1.04; letter-spacing: -.02em; max-width: 18ch; text-wrap: pretty; }
  .lede { max-width: 760px; }
  .meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 8px 0 0; padding-top: 18px; border-top: 1px solid var(--rule); }
  dt { margin-bottom: 4px; }
  dd { margin: 0; font-size: 15px; line-height: 1.45; }
  @media (max-width: 900px) { .ph { padding-top: 32px; padding-bottom: 28px; } .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
