---
// Two orbiting black holes on a canvas. Reads data-sep (0..1, 1 = widest) which other
// scripts can change; the pair eases to the new separation.
interface Props { sep?: number; label?: string; height?: number }
const { sep = 1, label = '', height = 420 } = Astro.props;
---
<div class="binary" data-binary data-sep={sep} style={`--h:${height}px`}>
  <canvas></canvas>
  <div class="tag mono" data-binary-label>{label}</div>
</div>
<style>
  .binary { position: relative; width: 100%; height: var(--h); background: var(--paper); border: 1px solid var(--rule); overflow: hidden; }
  canvas { display: block; width: 100%; height: 100%; }
  .tag { position: absolute; left: 14px; bottom: 12px; color: var(--muted); background: rgba(255,255,255,.8); padding: 4px 8px; }
</style>
<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-binary]');
  roots.forEach((root) => {
    const cv = root.querySelector('canvas')!; const ctx = cv.getContext('2d')!;
    let W = 0, H = 0, dpr = 1;
    const resize = () => { dpr = Math.min(2, window.devicePixelRatio || 1); W = root.clientWidth; H = root.clientHeight; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
    resize(); new ResizeObserver(resize).observe(root);
    const trail: { x: number; y: number; a: number }[][] = [[], []];
    let sep = parseFloat(root.dataset.sep ?? '1'); let cur = sep; let theta = 0; let last = performance.now();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ink = '#1a1714', accent = '#8b1e2a';
    const draw = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      sep = parseFloat(root.dataset.sep ?? '1');
      cur += (sep - cur) * Math.min(1, dt * 3);
      const R = Math.min(W, H) * 0.36 * (0.08 + 0.92 * cur);
      const q = 0.62;
      const omega = (0.35 + 2.4 * (1 - cur) ** 2) * (reduce ? 0.2 : 1);
      theta += omega * dt;
      const cx = W / 2, cy = H / 2;
      const p1 = { x: cx + R * q * Math.cos(theta), y: cy + R * q * 0.55 * Math.sin(theta) };
      const p2 = { x: cx - R * (1 - q) * Math.cos(theta), y: cy - R * (1 - q) * 0.55 * Math.sin(theta) };
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = '#e3ddd4'; ctx.lineWidth = 1;
      for (let i = 1; i <= 4; i++) { ctx.beginPath(); ctx.ellipse(cx, cy, (Math.min(W, H) * 0.42 * i) / 4, (Math.min(W, H) * 0.42 * 0.55 * i) / 4, 0, 0, Math.PI * 2); ctx.stroke(); }
      [p1, p2].forEach((p, i) => { trail[i].push({ x: p.x, y: p.y, a: 1 }); if (trail[i].length > 90) trail[i].shift(); });
      trail.forEach((t, i) => { ctx.beginPath(); t.forEach((pt, k) => { if (k === 0) ctx.moveTo(pt.x, pt.y); else ctx.lineTo(pt.x, pt.y); }); ctx.strokeStyle = i === 0 ? 'rgba(139,30,42,.35)' : 'rgba(26,23,20,.25)'; ctx.lineWidth = 1.2; ctx.stroke(); });
      const glow = (p: { x: number; y: number }, r: number, col: string) => { const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r * 4); g.addColorStop(0, col); g.addColorStop(1, 'rgba(255,255,255,0)'); ctx.fillStyle = g; ctx.beginPath(); ctx.arc(p.x, p.y, r * 4, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = ink; ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill(); };
      glow(p1, 7, 'rgba(139,30,42,.45)'); glow(p2, 10, 'rgba(139,30,42,.35)');
      ctx.strokeStyle = accent; ctx.setLineDash([3, 5]); ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke(); ctx.setLineDash([]);
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  });
</script>
