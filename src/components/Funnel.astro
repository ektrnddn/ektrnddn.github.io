---
// Selection funnel: bars on a log scale, animated on first view.
interface Row { value: number; display: string; label: string }
interface Props { rows: Row[]; title?: string }
const { rows, title } = Astro.props;
const max = Math.log10(Math.max(...rows.map((r) => r.value)));
const min = Math.log10(Math.min(...rows.map((r) => r.value))) - 0.6;
const pct = (v: number) => Math.max(6, Math.round(((Math.log10(v) - min) / (max - min)) * 100));
---
<div class="funnel" data-funnel>
  {title && <div class="mono head"><b>{title}</b> · log scale</div>}
  {rows.map((r) => (
    <div class="frow">
      <div class="flabel">{r.label}</div>
      <div class="fbar"><div class="fill" style={`--w:${pct(r.value)}%`}></div></div>
      <div class="fval">{r.display}</div>
    </div>
  ))}
</div>
<style>
  .funnel { display: flex; flex-direction: column; gap: 10px; }
  .head { margin-bottom: 4px; }
  .frow { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 5fr) minmax(0, 1.2fr); gap: 14px; align-items: center; }
  .flabel { font-size: 14px; line-height: 1.35; color: var(--text); }
  .fbar { height: 22px; background: var(--paper); border: 1px solid var(--rule); }
  .fill { height: 100%; width: 0; background: var(--accent); transition: width 1.2s cubic-bezier(.2,.7,.2,1); }
  .funnel.in .fill { width: var(--w); }
  .fval { font-family: var(--serif); font-size: 22px; letter-spacing: -.02em; text-align: right; font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) { .frow { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; } .flabel { font-size: 13px; } }
</style>
<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.3 });
  document.querySelectorAll('[data-funnel]').forEach((f) => io.observe(f));
</script>
