---
// The About timeline, from src/data/timeline.yaml. Three columns: where I studied; inside each,
// what mattered most (research and its papers, programmes, the start-up) with a bar as long as
// it lasted; on the right, the small things. Time runs down the page and a year with more in it
// grows taller. A line on the far left draws itself as the page scrolls and things appear as it
// passes. The labels are plain HTML; without the script they read as three lists.
import { timeline, publications, pubLink, decimalYear } from '../data/load';

const eras = timeline.eras.map((e) => ({ ...e, t: decimalYear(e.at), t1: e.to === undefined ? null : decimalYear(e.to) }));
const projects = timeline.projects.map((p) => ({
  ...p,
  t0: decimalYear(p.from),
  t1: p.to === undefined ? null : decimalYear(p.to),
  papers: (p.papers ?? []).map((x) => {
    const pub = x.id ? publications.find((q) => q.id === x.id) : undefined;
    return { ...x, url: pub ? pubLink(pub)?.url : undefined };
  }),
}));
let lastYear = '';
const along = timeline.along
  .map((a) => ({ ...a, t: decimalYear(a.at) }))
  .sort((a, b) => a.t - b.t)
  .map((a) => {
    const year = String(Math.floor(a.t));
    const show = year !== lastYear;
    lastYear = year;
    return { ...a, year: show ? year : '' };
  });
---
<div class="wl" data-wl>
  <svg data-svg aria-hidden="true"></svg>
  <div class="items">
    {eras.map((e) => (
      <div class:list={['lb', 'era', e.kind && 'minor']} data-type="era" data-t={e.t} data-t1={e.kind ? (e.t1 ?? '') : undefined} data-minor={e.kind ? '' : undefined} data-kind={e.kind}>
        <b>{e.title}</b>
        <span class="yrs">{e.years}</span>
        <span class="dd">{e.text}</span>
      </div>
    ))}
    {projects.map((p) => (
      <div class:list={['lb', 'imp', `w${p.w}`]} data-type="imp" data-t={p.t0} data-t1={p.t1 ?? ''} data-w={p.w}>
        <div class="hd"><b>{p.title}</b><span class="when">{p.when}</span></div>
        {p.text && <p class="dd">{p.text}</p>}
        {p.papers.length > 0 && (
          <ul>
            {p.papers.map((x) => (
              <li class:list={[x.role === 'First author' && 'fa', !x.url && 'soon']}>
                <span class="role">{x.role}</span>
                {x.url ? <a href={x.url} target="_blank" rel="noopener">{x.title}</a> : <span class="pt">{x.title}</span>}
                {x.venue && <span class="ven">{x.venue}</span>}
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
    {along.map((a) => (
      <div class:list={['lb', 'sm', `w${a.w}`]} data-type="sm" data-t={a.t} data-w={a.w}>
        <span class="y">{a.year}</span>
        <span class="k">{a.kind}</span>
        <span class="tx"><b>{a.title}</b>{a.place && <span class="dd">{a.place}</span>}</span>
      </div>
    ))}
    <div class="lb nowlb" data-now>Now</div>
  </div>
</div>

<style is:global>
  .wl { position: relative; margin-top: 72px; }
  .wl > svg { display: none; }
  /* Without the script: three plain lists. */
  .wl:not(.ready) .lb { margin-bottom: 14px; }
  .wl:not(.ready) .nowlb { display: none; }

  .wl.ready > svg { display: block; position: absolute; left: 0; top: 0; overflow: visible; z-index: 1; }
  /* What the pen has not reached yet waits out of focus and comes into focus as it passes. */
  .wl.ready .lb { position: absolute; z-index: 2; margin: 0; opacity: .32; filter: blur(2.6px); transition: opacity .6s ease, filter .6s ease; }
  .wl.ready .lb.on { opacity: 1; filter: none; }

  /* Where I studied */
  .wl .era b { display: block; font-size: var(--t-lg); font-weight: 500; letter-spacing: -.02em; line-height: 1.35; color: var(--ink); }
  .wl .era .yrs { display: block; margin-top: 4px; font-variant-numeric: tabular-nums; font-size: var(--t-xs); color: var(--ink); }
  .wl .era .dd { display: block; margin-top: 6px; font-size: var(--t-sm); line-height: 1.6; color: var(--muted); }
  .wl .era.minor b { display: inline; font-size: var(--t-md); letter-spacing: -.02em; line-height: 1.35; }
  .wl .era.minor .yrs { display: inline; margin: 0 0 0 10px; color: var(--muted); }
  .wl .era.minor .dd { margin-top: 2px; }
  .wl .nowlb { font-variant-numeric: tabular-nums; font-size: var(--t-xs); color: var(--ink); }

  /* What mattered most */
  .wl .imp .hd { display: flex; align-items: baseline; flex-wrap: wrap; column-gap: 10px; }
  .wl .imp b { font-size: var(--t-md); font-weight: 500; letter-spacing: -.02em; line-height: 1.35; color: var(--ink); }
  .wl .imp .when { font-variant-numeric: tabular-nums; font-size: var(--t-xs); color: var(--muted); white-space: nowrap; }
  .wl .imp .dd { margin-top: 4px; font-size: var(--t-sm); line-height: 1.6; color: var(--text); text-wrap: pretty; }
  .wl .imp.w2 b { font-size: var(--t-md); color: var(--text); }
  .wl .imp.w2 .dd { color: var(--muted); }
  .wl .imp ul { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .wl .imp li { font-size: var(--t-sm); line-height: 1.5; color: var(--text); }
  .wl .imp li .role { margin-right: 7px; font-variant-numeric: tabular-nums; font-size: var(--t-xs); color: var(--muted); }
  .wl .imp li.fa .role { color: var(--ink); }
  .wl .imp li a, .wl .imp li .pt { color: var(--ink); }
  .wl .imp li.fa a { font-weight: 500; }
  .wl .imp li.soon .pt { color: var(--muted); }
  .wl .imp li a:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .wl .imp li .ven { color: var(--muted); }
  .wl .imp li .ven::before { content: ' · '; }

  /* The small things */
  .wl .sm { display: grid; grid-template-columns: 40px 78px minmax(0, 1fr); column-gap: 10px; align-items: baseline; font-size: var(--t-sm); line-height: 1.5; color: var(--muted); }
  .wl .sm .y, .wl .sm .k { font-variant-numeric: tabular-nums; font-size: var(--t-xs); color: var(--muted); white-space: nowrap; }
  .wl .sm b { font-weight: 400; color: var(--text); }
  .wl .sm .dd::before { content: ' · '; }
  .wl .sm.w1 b { font-weight: 500; color: var(--ink); }
  .wl .sm.w1 .k { color: var(--ink); }
  .wl .sm.w3 b { color: var(--muted); }
  .wl .lb.hl b { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  .wl svg .life { stroke: var(--ink); stroke-width: 2; fill: none; stroke-linecap: round; }
  .wl svg .node { fill: var(--paper); stroke: var(--ink); stroke-width: 2; }
  .wl svg .bar { stroke: var(--ink); stroke-width: 2.5; fill: none; stroke-linecap: round; transition: stroke-width .2s; }
  .wl svg .bar.w2 { stroke: var(--soft); stroke-width: 1.6; }
  .wl svg .bar.hl { stroke-width: 4; }
  .wl svg .guide { stroke: var(--rule); stroke-width: 1.3; fill: none; }
  .wl svg .guide-ink { stroke: var(--faint); stroke-width: 1.3; fill: none; }
  .wl svg .sdot { fill: var(--soft); }
  .wl svg .sdot.w1 { fill: var(--ink); }
  .wl svg .sdot.w3 { fill: var(--faint); }
  .wl svg .ld { stroke: var(--faint); stroke-width: 1; fill: none; }
  .wl svg .ghost { stroke: var(--rule); stroke-width: 2; fill: none; stroke-linecap: round; }
  .wl svg .ghost.w1 { stroke-width: 2.5; }
  .wl svg .ghost.w2 { stroke-width: 1.6; }
  .wl svg .ghost-dot { fill: var(--rule); }
  .wl svg .g, .wl svg .ld { opacity: .3; transition: opacity .5s; }
  .wl svg .g.on, .wl svg .ld.on { opacity: 1; }
  .wl svg .g.hl { transform: scale(1.8); transform-box: fill-box; transform-origin: center; }
  .wl svg .pen { fill: var(--ink); }
  .wl svg .nowdot { fill: var(--rose); transform-box: fill-box; transform-origin: center; }
  .wl svg .future { opacity: .3; transition: opacity 1s ease .2s; }
  .wl svg .future.on { opacity: 1; }
  .wl svg .future path { stroke: var(--ink); stroke-width: 2; fill: none; stroke-dasharray: 2 5; stroke-linecap: round; }
  .wl svg .future path.w2 { stroke: var(--soft); stroke-width: 1.6; }
  .wl svg .future path.w3 { stroke: var(--faint); stroke-width: 1.3; }
  .wl.done svg .nowdot { animation: tl-breathe 2.6s ease-in-out infinite; }
  @keyframes tl-breathe { 50% { transform: scale(1.35); } }

  @media (max-width: 719px) {
    .wl { margin-top: 56px; }
    .wl .era b { font-size: var(--t-lg); }
    .wl .imp b { font-size: var(--t-md); }
    .wl .imp.w2 b { font-size: var(--t-sm); }
    .wl .era.minor b { font-size: var(--t-md); }
    .wl .sm { grid-template-columns: 36px 70px minmax(0, 1fr); column-gap: 8px; font-size: var(--t-sm); }
    .wl .sm .y, .wl .sm .k { font-size: var(--t-xs); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wl.ready .lb, .wl svg .g, .wl svg .ld, .wl svg .future { transition: none; }
    .wl.done svg .nowdot { animation: none; }
  }
</style>

<script>
  const wl = document.querySelector<HTMLElement>('[data-wl]');
  if (wl) {
    const NS = 'http://www.w3.org/2000/svg';
    const svg = wl.querySelector<SVGSVGElement>('[data-svg]')!;
    const nowEl = wl.querySelector<HTMLElement>('[data-now]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const today = new Date();
    const NOW = today.getFullYear() + (today.getMonth() + (today.getDate() - 1) / 31) / 12;

    type Item = { el: HTMLElement; type: string; col: number; t: number; t1: number | null; w: number; k: number; h: number; c: number; g: number; y: number; minor: boolean; training: boolean; mark?: SVGElement };
    const items: Item[] = [...wl.querySelectorAll<HTMLElement>('.lb[data-type]')].map((el) => {
      const type = el.dataset.type!;
      let t1 = el.dataset.t1 ? Number(el.dataset.t1) : null;
      if (t1 !== null && t1 >= NOW) t1 = null;                    // still going on
      return { el, type, col: type === 'era' ? 1 : type === 'imp' ? 2 : 3, t: Number(el.dataset.t), t1, w: Number(el.dataset.w ?? 1), k: 0, h: 0, c: 0, g: 0, y: 0,
        minor: el.dataset.minor !== undefined, training: el.dataset.kind === 'training' };
    });
    const T0 = Math.min(...items.map((it) => it.t));
    const imp = items.filter((it) => it.type === 'imp').sort((a, b) => a.t - b.t);
    // Overlapping bars sit side by side.
    const laneEnd: number[] = [];
    for (const it of imp) {
      let k = laneEnd.findIndex((e) => e < it.t - 0.01);
      if (k < 0) { k = laneEnd.length; laneEnd.push(0); }
      laneEnd[k] = it.t1 ?? Infinity; it.k = k + 1;
    }
    const LANES = laneEnd.length;
    // In the first column, the collaborations and trainings branch off the line, side by side.
    const minors = items.filter((it) => it.minor).sort((a, b) => a.t - b.t);
    const laneEnd1: number[] = [];
    for (const it of minors) {
      let k = laneEnd1.findIndex((e) => e < it.t - 0.004);
      if (k < 0) { k = laneEnd1.length; laneEnd1.push(0); }
      laneEnd1[k] = it.t1 ?? Infinity; it.k = k + 1;
    }
    const LANES1 = laneEnd1.length;

    const el = (tag: string, attrs: Record<string, string | number>, parent: Element = svg) => {
      const n = document.createElementNS(NS, tag);
      for (const a in attrs) n.setAttribute(a, String(attrs[a]));
      parent.appendChild(n);
      return n as SVGElement;
    };

    let Y: (t: number) => number = (t) => t;
    let H = 0, cur = -1, raf = 0;
    let reveal: { nodes: Element[]; y: number }[] = [];
    let bars: { p: SVGElement; y0: number; len: number }[] = [];
    let life: SVGElement, pen: SVGElement, nowDot: SVGElement, future: SVGElement;

    const layout = () => {
      svg.textContent = ''; reveal = []; bars = [];
      wl.classList.add('ready');
      const W = wl.clientWidth, mobile = W < 720;
      const LINE = 6;
      let LG: number, L1G: number, C1X: number, C1W: number, C1M: number, C2B: number, C2X: number, C2W: number, C3X: number, C3W: number;
      if (mobile) {
        LG = 10; L1G = 9; C2B = LINE + LANES1 * L1G + 14; const X = C2B + LANES * LG + 10;
        [C1X, C1W, C1M, C2X, C2W, C3X, C3W] = [X, W - X, X, X, W - X, X, W - X];
      } else {
        LG = 14; L1G = 13; C1X = 30; C1W = Math.round(W * 0.21); C1M = LINE + LANES1 * L1G + 20;
        C2B = C1X + C1W + 26; C2X = C2B + LANES * LG + 12; C2W = Math.round(W * 0.32);
        C3X = C2X + C2W + 52; C3W = W - C3X;
      }
      const laneX = (it: Item) => C2B + (it.k - 1) * LG;
      const laneX1 = (it: Item) => LINE + it.k * L1G;
      for (const it of items) {
        const [x, w] = it.minor ? [C1M, C1X + C1W - C1M] : it.col === 1 ? [C1X, C1W] : it.col === 2 ? [C2X, C2W] : [C3X, C3W];
        Object.assign(it.el.style, { left: `${x}px`, width: `${w}px` });
      }
      for (const it of items) {
        it.h = it.el.offsetHeight;
        it.c = it.type === 'era' ? (it.el.dataset.minor !== undefined ? 12 : 14) : it.type === 'imp' ? (it.w === 1 ? 12 : 11) : 11;   // middle of the first line
        it.g = it.type === 'sm' ? (mobile ? 9 : 7) : it.el.dataset.minor !== undefined ? 18 : mobile ? 18 : 30;   // space after it
      }

      // One time scale for all three columns, so a date sits at the same height across the page.
      // Time runs down at a steady rate; going through the items in date order, wherever a column
      // still needs room for the block above, time pauses there for every column. Each block
      // starts at its own date; only blocks that share a date in one column stack.
      const top0 = 34, B = mobile ? 84 : 96;
      const kts: number[] = [T0], kys: number[] = [top0];        // the scale's breakpoints
      const free = new Map<string, number>();                     // where each column is free again
      const ahead = (t: number) => kys[kys.length - 1] + (t - kts[kts.length - 1]) * B;
      const place = (t: number, need: number) => {
        const later = t > kts[kts.length - 1] + 1e-6;
        if (later && need > ahead(t)) {
          // time pauses just before this date: the room opens there instead of being spread
          // over the months before, so what lasts a few days still looks short
          const tp = t - 0.004;
          if (tp > kts[kts.length - 1] + 1e-6) { kts.push(tp); kys.push(ahead(tp)); }
          kts.push(t); kys.push(need);
          return need;
        }
        const y = Math.max(ahead(t), need);
        if (later) { kts.push(t); kys.push(y); }
        return y;
      };
      for (const it of [...items].sort((a, b) => a.t - b.t)) {
        const col = mobile ? 'all' : String(it.col);
        const y = place(Math.max(T0, Math.min(NOW, it.t)), (free.get(col) ?? -Infinity) + it.c);
        it.y = y - it.c; it.el.style.top = `${it.y}px`;
        free.set(col, it.y + it.h + it.g);
      }
      const nowCol = mobile ? 'all' : '1';
      place(NOW, (free.get(nowCol) ?? -Infinity) + 14);            // room for "Now"
      Y = (t: number) => {
        t = Math.max(T0, Math.min(NOW, t));
        let i = 0;
        while (i < kts.length - 1 && kts[i + 1] < t) i++;
        if (i >= kts.length - 1) return ahead(t);
        return kys[i] + ((t - kts[i]) / (kts[i + 1] - kts[i])) * (kys[i + 1] - kys[i]);
      };

      const leader = (x1: number, y1: number, x2: number, y2: number) => {
        const m = (x2 - x1) * 0.5;
        return Math.abs(y2 - y1) < 0.6 ? `M${x1},${y1} H${x2}` : `M${x1},${y1} C${x1 + m},${y1} ${x2 - m},${y2} ${x2},${y2}`;
      };

      // The small things hang off a faint line of their own (on phones, off the main one).
      const gx = mobile ? LINE : C3X - 20;
      if (!mobile) {
        el('path', { d: `M${gx},${Y(T0)} V${Y(NOW)}`, class: 'guide' });
        const gp = el('path', { d: `M${gx},${Y(T0)} V${Y(NOW)}`, class: 'guide-ink' });
        const gl = Y(NOW) - Y(T0); gp.style.strokeDasharray = `${gl} ${gl}`;
        bars.push({ p: gp, y0: Y(T0), len: gl });
      }
      for (const it of items) {
        if (it.type !== 'sm') continue;
        const y = Y(it.t);
        const ld = el('path', { d: leader(gx + 4, y, C3X - 6, it.y + it.c), class: 'ld' });
        const dot = el('circle', { cx: gx, cy: y, r: it.w === 1 ? 3.4 : it.w === 2 ? 2.8 : 2.4, class: `g sdot w${it.w}` });
        reveal.push({ nodes: [it.el, ld, dot], y });
        it.mark = dot;
      }

      // Bars for what mattered most, as long as it lasted, with its block beside it.
      for (const it of imp) {
        const x = laneX(it), y0 = Y(it.t), y1 = Math.max(it.t1 === null ? Y(NOW) : Y(it.t1), y0 + 10), len = y1 - y0;
        const ld = el('path', { d: leader(x + 5, y0, C2X - 6, it.y + it.c), class: 'ld' });
        el('path', { d: `M${x},${y0} V${y1}`, class: `ghost w${it.w}` });
        const p = el('path', { d: `M${x},${y0} V${y1}`, class: `bar w${it.w}` });
        p.style.strokeDasharray = `${len} ${len}`;
        bars.push({ p, y0, len });
        reveal.push({ nodes: [it.el, ld], y: y0 });
        it.mark = p;
      }

      // The collaborations and trainings: a bar beside the line from start to end, as in the
      // second column (not joined to the line); those still going on run to now and on, dashed.
      for (const it of minors) {
        const x = laneX1(it), y0 = Y(it.t), y1 = Math.max(it.t1 === null ? Y(NOW) : Y(it.t1), y0 + 10), len = y1 - y0;
        const w = it.training ? 'w2' : 'w1';
        const ld = el('path', { d: leader(x + 5, y0, C1M - 6, it.y + it.c), class: 'ld' });
        el('path', { d: `M${x},${y0} V${y1}`, class: `ghost ${w}` });
        const p = el('path', { d: `M${x},${y0} V${y1}`, class: `bar ${w}` });
        p.style.strokeDasharray = `${len} ${len}`;
        bars.push({ p, y0, len });
        reveal.push({ nodes: [it.el, ld], y: y0 });
        it.mark = p;
      }

      // The line itself, with a mark where each school begins.
      el('path', { d: `M${LINE},${Y(T0)} V${Y(NOW)}`, class: 'ghost' });
      life = el('path', { d: `M${LINE},${Y(T0)} V${Y(NOW)}`, class: 'life' });
      const ll = Y(NOW) - Y(T0); life.style.strokeDasharray = `${ll} ${ll}`;
      for (const it of items) {
        if (it.type !== 'era' || it.minor) continue;
        const y = Y(it.t);
        const ld = el('path', { d: leader(LINE + 8, y, C1X - 6, it.y + it.c), class: 'ld' });
        const node = el('circle', { cx: LINE, cy: y, r: 6, class: 'g node' });
        reveal.push({ nodes: [it.el, ld, node], y });
      }

      // After now: dashed and fading, for the line and for what is still going on.
      const defs = el('defs', {});
      const grad = el('linearGradient', { id: 'tl-fade', x1: 0, y1: Y(NOW), x2: 0, y2: Y(NOW) + 90, gradientUnits: 'userSpaceOnUse' }, defs);
      el('stop', { offset: 0, 'stop-color': '#fff', 'stop-opacity': 1 }, grad);
      el('stop', { offset: 1, 'stop-color': '#fff', 'stop-opacity': 0 }, grad);
      const mask = el('mask', { id: 'tl-fade-mask', maskUnits: 'userSpaceOnUse', x: 0, y: Y(NOW), width: W, height: 96 }, defs);
      el('rect', { x: 0, y: Y(NOW), width: W, height: 96, fill: 'url(#tl-fade)' }, mask);
      future = el('g', { class: 'future', mask: 'url(#tl-fade-mask)' });
      el('path', { d: `M${LINE},${Y(NOW) + 9} V${Y(NOW) + 90}` }, future);
      for (const it of imp) if (it.t1 === null) el('path', { d: `M${laneX(it)},${Y(NOW) + 6} V${Y(NOW) + 72}`, class: `w${it.w}` }, future);
      for (const it of minors) if (it.t1 === null) el('path', { d: `M${laneX1(it)},${Y(NOW) + 6} V${Y(NOW) + 72}`, class: it.training ? 'w2' : '' }, future);
      if (!mobile) el('path', { d: `M${gx},${Y(NOW) + 6} V${Y(NOW) + 72}`, class: 'w3' }, future);
      el('circle', { cx: LINE, cy: Y(NOW), r: 5.5, class: 'ghost-dot' });
      nowDot = el('circle', { cx: LINE, cy: Y(NOW), r: 5.5, class: 'nowdot' });
      Object.assign(nowEl.style, { left: `${C1M}px`, top: `${Y(NOW) - 9}px` });
      pen = el('circle', { cx: LINE, cy: Y(T0), r: 3.4, class: 'pen' });

      H = Math.max(Y(NOW) + 100, ...items.map((it) => it.y + it.h)) + 30;
      wl.style.height = `${H}px`;
      svg.setAttribute('width', String(W)); svg.setAttribute('height', String(H)); svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

      // Hovering a block marks its bar; hovering a small thing marks its dot.
      for (const it of items) {
        const mark = it.mark;
        if (!mark) continue;
        it.el.onmouseenter = () => { mark.classList.add('hl'); it.el.classList.add('hl'); };
        it.el.onmouseleave = () => { mark.classList.remove('hl'); it.el.classList.remove('hl'); };
      }
      cur = Math.min(cur, H); draw(true);
    };

    // Scrolling moves a pen down the line; whatever it has passed is drawn.
    const target = () => {
      if (reduce) return H + 1;
      const end = scrollY + innerHeight >= document.documentElement.scrollHeight - 4;
      return end ? H + 1 : innerHeight * 0.85 - wl.getBoundingClientRect().top;
    };
    const draw = (jump: boolean) => {
      const t = Math.max(-1, Math.min(H + 1, target()));
      cur = jump ? t : cur + (t - cur) * 0.14;
      if (Math.abs(t - cur) < 0.4) cur = t;
      const y0 = Y(T0), yN = Y(NOW);
      life.style.strokeDashoffset = String(yN - y0 - Math.max(0, Math.min(yN - y0, cur - y0)));
      for (const b of bars) b.p.style.strokeDashoffset = String(b.len - Math.max(0, Math.min(b.len, cur - b.y0)));
      for (const r of reveal) { const on = cur >= r.y - 1; for (const n of r.nodes) n.classList.toggle('on', on); }
      const done = cur >= yN - 0.5;
      pen.setAttribute('cy', String(Math.min(cur, yN))); pen.style.opacity = cur > y0 && !done ? '1' : '0';
      nowDot.style.opacity = done ? '1' : '0'; nowEl.classList.toggle('on', done);
      future.classList.toggle('on', done); wl.classList.toggle('done', done);
      raf = cur !== t ? requestAnimationFrame(() => draw(false)) : 0;
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => draw(false)); }, { passive: true });
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(layout, 120); });
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(layout);
  }
</script>
