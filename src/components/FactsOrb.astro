---
// A small star on the right edge. It grows on hover; a click opens a panel with a few
// personal facts. Closes on the ×, a click outside, or Escape.
import Icon from './Icon.astro';
import { facts } from '../data/load';
---
<div class="forb" data-forb>
  <button type="button" class="knob" aria-label="A few things about me" aria-expanded="false" aria-controls="facts-panel" data-forb-btn>
    <Icon name="star" size={18} />
  </button>
  <div class="panel" id="facts-panel" role="dialog" aria-label="A few things about me" hidden>
    <div class="head">
      <span class="mono">A few things about me</span>
      <button type="button" class="close" aria-label="Close" data-forb-close><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg></button>
    </div>
    <ul>
      {facts.map((f) => (
        <li>
          <span class="ico">{(Array.isArray(f.icon) ? f.icon : [f.icon]).map((n) => <Icon name={n} size={18} />)}</span>
          <span>{f.text} {f.link && <a href={f.link} target="_blank" rel="noopener">{f.link_label ?? f.link}</a>}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
<style>
  .forb { position: fixed; right: 22px; top: 50%; transform: translateY(-50%); z-index: 30; display: flex; align-items: center; justify-content: flex-end; touch-action: none; }
  .forb.moved { transform: none; }
  .forb.dragging .knob { cursor: grabbing; transform: scale(1.15); transition: none; }
  .knob { cursor: grab; appearance: none; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--ink); background: var(--bg); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: transform .35s cubic-bezier(.2,.7,.2,1), background .25s, color .25s, box-shadow .35s; box-shadow: 0 6px 20px -12px rgba(0,0,0,.35); }
  .knob:hover { transform: scale(1.35) rotate(18deg); }
  .forb.open .knob { background: var(--ink); color: var(--bg); transform: scale(1); }
  .knob :global(svg) { transition: transform .35s; }
  .forb.open .knob :global(svg) { transform: rotate(72deg); }
  .panel { position: absolute; right: 52px; top: 50%; width: min(380px, calc(100vw - 96px)); transform: translateY(-50%) scale(.92); transform-origin: right center; background: var(--paper); border: 1px solid var(--rule); border-radius: 14px; padding: 16px 18px 8px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.3); opacity: 0; transition: opacity .28s ease, transform .35s cubic-bezier(.2,.7,.2,1); }
  .panel[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .forb.open .panel { opacity: 1; transform: translateY(-50%) scale(1); visibility: visible; pointer-events: auto; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 6px; }
  .close { appearance: none; border: 0; background: none; color: var(--muted); width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .close:hover { color: var(--ink); background: #f2f2f2; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; gap: 12px; align-items: flex-start; padding: 10px 0; border-top: 1px solid var(--rule); font-size: 14.5px; line-height: 1.5; color: var(--text); }
  .ico { flex: none; color: var(--ink); display: inline-flex; gap: 5px; margin-top: 3px; }
  li a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #c8c8c8; }
  li a:hover { text-decoration-color: var(--ink); }
  @media (max-width: 900px) {
    .forb { right: 16px; top: auto; bottom: 22px; transform: none; }
    .panel { right: 0; top: auto; bottom: 52px; transform: scale(.92); transform-origin: right bottom; }
    .forb.open .panel { transform: scale(1); }
    .knob:hover { transform: none; }
  }
</style>
<script>
  const orb = document.querySelector<HTMLElement>('[data-forb]');
  if (orb) {
    const btn = orb.querySelector<HTMLButtonElement>('[data-forb-btn]')!;
    const panel = orb.querySelector<HTMLElement>('#facts-panel')!;
    const open = () => {
      // put the panel on whichever side of the star has room, and keep it on screen vertically
      const r = btn.getBoundingClientRect(); const pw = Math.min(380, innerWidth - 96);
      const leftSide = r.left - 60 - pw < 8 && innerWidth > 900;
      panel.style.right = leftSide ? 'auto' : '52px'; panel.style.left = leftSide ? '52px' : 'auto';
      panel.style.transformOrigin = leftSide ? 'left center' : 'right center';
      panel.hidden = false;
      requestAnimationFrame(() => {
        orb.classList.add('open');
        const pr = panel.getBoundingClientRect();
        const over = Math.max(0, pr.bottom - innerHeight + 12) - Math.max(0, 12 - pr.top);
        if (over) panel.style.top = `calc(50% - ${over}px)`;
      });
      btn.setAttribute('aria-expanded', 'true');
    };
    const close = () => { orb.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); setTimeout(() => { if (!orb.classList.contains('open')) panel.hidden = true; }, 350); };
    // Hold and drag to move the star anywhere; a short press without moving opens the panel.
    let drag: { x: number; y: number; ox: number; oy: number; moved: boolean } | null = null;
    const place = (x: number, y: number) => {
      const w = btn.offsetWidth, h = btn.offsetHeight;
      x = Math.max(8, Math.min(innerWidth - w - 8, x)); y = Math.max(8, Math.min(innerHeight - h - 8, y));
      orb.classList.add('moved'); orb.style.left = `${x}px`; orb.style.top = `${y}px`; orb.style.right = 'auto'; orb.style.bottom = 'auto';
      return { x, y };
    };
    try { const saved = JSON.parse(localStorage.getItem('facts-orb') ?? 'null'); if (saved && innerWidth > 900) place(saved.x, saved.y); } catch {}
    btn.addEventListener('pointerdown', (e) => {
      const r = btn.getBoundingClientRect();
      drag = { x: e.clientX, y: e.clientY, ox: r.left, oy: r.top, moved: false };
      btn.setPointerCapture(e.pointerId);
    });
    btn.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 6) return;
      drag.moved = true; orb.classList.add('dragging'); close();
      place(drag.ox + dx, drag.oy + dy);
    });
    const release = () => {
      if (!drag) return;
      const wasDrag = drag.moved; drag = null; orb.classList.remove('dragging');
      if (wasDrag) { const r = btn.getBoundingClientRect(); try { localStorage.setItem('facts-orb', JSON.stringify({ x: r.left, y: r.top })); } catch {} return; }
      orb.classList.contains('open') ? close() : open();
    };
    btn.addEventListener('pointerup', release); btn.addEventListener('pointercancel', () => { drag = null; orb.classList.remove('dragging'); });
    window.addEventListener('resize', () => { if (orb.classList.contains('moved')) { const r = btn.getBoundingClientRect(); place(r.left, r.top); } });
    orb.querySelector('[data-forb-close]')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    document.addEventListener('pointerdown', (e) => { if (!orb.contains(e.target as Node)) close(); });
  }
</script>
